            "demandAndSupplyPlans-item-response":{
                "description":"The following table describes the default response for this task.",
                "headers":{
                    "Metadata-Context":{
                        "$ref":"#/components/headers/Metadata-Context"
                    },
                    "REST-Framework-Version":{
                        "$ref":"#/components/headers/REST-Framework-Version"
                    }
                },
                "content":{
                    "application/json":{
                        "schema":{
                            "$ref":"#/components/schemas/demandAndSupplyPlans-item-response"
                        }
                    }
                },
                "links":{
                    "SupplyExceptions":{
                        "operationRef":"#/paths/~1demandAndSupplyPlans~1{PlanId}~1child~1SupplyExceptions/get",
                        "parameters":{
                            "PlanId":"$request.path.PlanId"
                        },
                        "description":"Order-based exceptions for supplies when only supply-related exceptions are generated by planning. For example, the exception Orders to be Rescheduled Out for supplies is generated for supplies that have been rescheduled to a date later than their prior due date based on the earliest pegged demands date in the plan."
                    },
                    "DemandExceptions":{
                        "operationRef":"#/paths/~1demandAndSupplyPlans~1{PlanId}~1child~1DemandExceptions/get",
                        "parameters":{
                            "PlanId":"$request.path.PlanId"
                        },
                        "description":"Order-based exceptions for demands when only demand-related exceptions are generated by planning. For example, the exception Demand at Risk Due to Insufficient Lead Time for demands that are at risk when they're pegged to supplies with insufficient lead time in the plan."
                    },
                    "AnalyzingLateDemands":{
                        "operationRef":"#/paths/~1demandAndSupplyPlans~1{PlanId}~1child~1AnalyzingLateDemands/get",
                        "parameters":{
                            "PlanId":"$request.path.PlanId"
                        },
                        "description":"The root cause for the lateness of an end demand."
                    },
                    "PlanningSupplies":{
                        "operationRef":"#/paths/~1demandAndSupplyPlans~1{PlanId}~1child~1PlanningSupplies/get",
                        "parameters":{
                            "PlanId":"$request.path.PlanId"
                        },
                        "description":"The Planning Supplies resource manages the supply orders such as work orders and purchase orders that are part of the plan."
                    },
                    "SupplierExceptions":{
                        "operationRef":"#/paths/~1demandAndSupplyPlans~1{PlanId}~1child~1SupplierExceptions/get",
                        "parameters":{
                            "PlanId":"$request.path.PlanId"
                        },
                        "description":"Order-based exceptions for suppliers, generated by planning. For example, the exception Supplier Capacity Constraints is generated for the item supplier and supplier site combination which is constrained by the capacity for planning supplies."
                    },
                    "ResourceRequirements":{
                        "operationRef":"#/paths/~1demandAndSupplyPlans~1{PlanId}~1child~1ResourceRequirements/get",
                        "parameters":{
                            "PlanId":"$request.path.PlanId"
                        },
                        "description":"The resource requirements for resources generated by planning."
                    },
                    "Runs":{
                        "operationRef":"#/paths/~1demandAndSupplyPlans~1{PlanId}~1child~1Runs/get",
                        "parameters":{
                            "PlanId":"$request.path.PlanId"
                        },
                        "description":"The Runs resource manages the run details about the demand and supply plan. You can use this resource to run demand and supply plans."
                    },
                    "ItemExceptions":{
                        "operationRef":"#/paths/~1demandAndSupplyPlans~1{PlanId}~1child~1ItemExceptions/get",
                        "parameters":{
                            "PlanId":"$request.path.PlanId"
                        },
                        "description":"The order-based exceptions for items where only item related exceptions are generated by planning. For example, an exception such as Items below Safety Stock where an exception for items that are below a safety stock level are calculated by the plan."
                    },
                    "ItemRelationships":{
                        "operationRef":"#/paths/~1demandAndSupplyPlans~1{PlanId}~1child~1ItemRelationships/get",
                        "parameters":{
                            "PlanId":"$request.path.PlanId"
                        },
                        "description":"Associations between items, such as components or substitutes, are considered data in Oracle Supply Chain Planning to support planning and analysis activities."
                    },
                    "Items":{
                        "operationRef":"#/paths/~1demandAndSupplyPlans~1{PlanId}~1child~1Items/get",
                        "parameters":{
                            "PlanId":"$request.path.PlanId"
                        },
                        "description":"The Items resource manages the items within a simulation set used as input for the Oracle Supply Chain Planning Cloud solution."
                    },
                    "ResourceExceptions":{
                        "operationRef":"#/paths/~1demandAndSupplyPlans~1{PlanId}~1child~1ResourceExceptions/get",
                        "parameters":{
                            "PlanId":"$request.path.PlanId"
                        },
                        "description":"Order-based exceptions for resources generated by planning. For example, the exception Resource Capacity Constraints is generated for resources that are constrained by capacity for planning supplies."
                    },
                    "workDefinitionVersions":{
                        "operationRef":"#/paths/~1demandAndSupplyPlans~1{PlanId}~1child~1workDefinitionVersions/get",
                        "parameters":{
                            "PlanId":"$request.path.PlanId"
                        },
                        "description":"The WorkDefinitionsVersions resource manages the work definitions and their different versions."
                    },
                    "PlanningDemands":{
                        "operationRef":"#/paths/~1demandAndSupplyPlans~1{PlanId}~1child~1PlanningDemands/get",
                        "parameters":{
                            "PlanId":"$request.path.PlanId"
                        },
                        "description":"The Planning Demands resource manages the demand orders and forecasts that are part of the plan."
                    },
                    "Resources":{
                        "operationRef":"#/paths/~1demandAndSupplyPlans~1{PlanId}~1child~1Resources/get",
                        "parameters":{
                            "PlanId":"$request.path.PlanId"
                        },
                        "description":"The Resources resource manages the collected resources used as input for the Oracle Supply Chain Planning Cloud solution."
                    }
                }
            },
