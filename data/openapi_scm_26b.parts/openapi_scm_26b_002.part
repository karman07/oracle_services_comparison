                        },
                        "description":"An attribute that's relevant to a resource for sequencing."
                    },
                    "manufacturingAttributeGroups":{
                        "operationRef":"#/paths/~1productionSchedulingOrganizations~1{OrganizationId}~1child~1manufacturingAttributeGroups/get",
