                            "OrganizationId":"$request.path.OrganizationId"
                        },
                        "description":"The Item Class Attribute Groups specifies attribute group code for an item business object."
                    },
                    "replaceFlowSequencingRules":{
                        "operationRef":"#/paths/~1productionSchedulingOrganizations~1{OrganizationId}~1action~1replaceFlowSequencingRules/post",
                        "parameters":{
                            "OrganizationId":"$request.path.OrganizationId"
                        },
                        "description":"Initiates a request to replace flow sequencing rules from an existing production line that produces the same items."
                    },
                    "attributes":{
                        "operationRef":"#/paths/~1productionSchedulingOrganizations~1{OrganizationId}~1child~1attributes/get",
                        "parameters":{
                            "OrganizationId":"$request.path.OrganizationId"
                        },
                        "description":"The Attributes resource manages the attributes by organization and normalizes the attributes that can be defined by manufacturing attribute groups and item class attribute groups."
                    },
                    "deleteFlowSequencingRules":{
                        "operationRef":"#/paths/~1productionSchedulingOrganizations~1{OrganizationId}~1action~1deleteFlowSequencingRules/post",
                        "parameters":{
                            "OrganizationId":"$request.path.OrganizationId"
                        },
                        "description":"Requests the deletion of flow sequencing rules for an existing production line."
                    },
                    "attributeSequences":{
                        "operationRef":"#/paths/~1productionSchedulingOrganizations~1{OrganizationId}~1child~1attributeSequences/get",
                        "parameters":{
                            "OrganizationId":"$request.path.OrganizationId"
                        },
                        "description":"The Attribute Sequences resource manages the user directed sequence in which an attribute should be processed on a manufacturing resource."
                    },
                    "flowSequencingRules":{
                        "operationRef":"#/paths/~1productionSchedulingOrganizations~1{OrganizationId}~1child~1flowSequencingRules/get",
                        "parameters":{
                            "OrganizationId":"$request.path.OrganizationId"
                        },
                        "description":"Rules defined by an organization to specify the sequencing logic on a production line."
                    }
                }
            },
