            "oracle_apps_scm_advancedPlanning_common_planRuns_restModel_view_ISDPlanRunsVO-patch-item":{
                "type":"object",
                "properties":{
                    "ActionParams":{
                        "type":"string",
                        "description":"List of entities to be refreshed. A comma separates each value. Valid values are 2: Demand history and measures, 3: Forecasts, 4: Sales orders, and 6: Supplies. There is no default value. This attribute is ignored unless Mode is set to 2.",
                        "nullable":true
                    },
                    "ApproveDemandPlanFlag":{
                        "type":"boolean",
                        "description":"Contains one of the following values: 1 or 2. If 1, then automatically approve the demand forecast after running the plan. If 2, then don't approve.",
                        "nullable":true
                    },
                    "ArchivePlanFlag":{
                        "type":"boolean",
                        "description":"Contains one of the following values: true or false. If true, then archive the plan before the next plan run. If false, then don't archive. The default value is false. Note that you can archive a plan only if you enable it for archiving. Use the Enable for Archiving attribute in one of the work areas for supply chain planning to enable it.",
                        "nullable":true
                    },
                    "CausalFactorsFlag":{
                        "type":"boolean",
                        "description":"Contains one of the following values: true or false. If true, then include details of the causal factors that make up the forecast. If false, then don't provide these details. You must set this attribute to true to view the forecast details that the causal factor group creates.",
                        "nullable":true
                    },
                    "EndDate":{
                        "type":"string",
                        "description":"Date and time when the plan run completed.",
                        "format":"date-time",
                        "nullable":true
                    },
                    "ExecutionId":{
                        "type":"integer",
                        "description":"Value that uniquely identifies the process.",
                        "format":"int64",
                        "nullable":false,
                        "x-hints":{
                            "precision":18
                        }
                    },
                    "ExecutionUser":{
                        "maxLength":64,
                        "type":"string",
                        "description":"Login that the user used when launching the process.",
                        "nullable":false
                    },
                    "ForceRunFlag":{
                        "type":"boolean",
                        "description":"Contains one of the following values: true or false. If true, then run the plan regardless of the current plan status. If false, then run the plan only if the plan is ready to run. The default value is false.",
                        "nullable":true
                    },
                    "ForecastBookingsFlag":{
                        "type":"boolean",
                        "description":"Contains one of the following values: 1 or 2. If 1, then include the forecast bookings profile when running the plan. If 2, then don't include this profile. You must include the forecast bookings profile or the forecast shipments profile when you run the forecast process.",
                        "nullable":true
                    },
                    "ForecastMethodsFlag":{
                        "type":"boolean",
                        "description":"Contains one of the following values: true or false. If true, then include details of the forecast methods that make up the forecast. If false, then don't provide these details. You must set this attribute to true to view the forecast details that the forecast method creates.",
                        "nullable":true
                    },
                    "ForecastProfiles":{
                        "type":"string",
                        "description":"List of forecast profiles that the plan run uses. A comma separates each forecast profile name.",
                        "nullable":true
                    },
                    "ForecastShipmentsFlag":{
                        "type":"boolean",
                        "description":"Contains one of the following values: 1 or 2. If 1, then include the forecast shipments profile when running the plan. If 2, then don't include this profile. You must include the forecast bookings profile or the forecast shipments profile when you run the forecast process.",
                        "nullable":true
                    },
                    "JobId":{
                        "type":"integer",
                        "description":"Value that uniquely identifies the scheduled process.",
                        "format":"int64",
                        "nullable":true,
                        "x-hints":{
                            "precision":18
                        }
                    },
                    "Message":{
                        "type":"string",
                        "description":"Text of the error messages, if any, that occurred when running the scheduled process.",
                        "nullable":true
                    },
                    "Mode":{
                        "type":"string",
                        "description":"Specifies whether data is to be refreshed or not. Contains one of the following values: 1, 2, or 3. If 1, then all data is refreshed. If 2, then only selected entities are refreshed. If 3, then data isn't refreshed. The default value is 1.",
                        "nullable":true
                    },
                    "PlanDemandFlag":{
                        "type":"boolean",
                        "description":"Contains one of the following values: true or false. If true, then run the demand planning engine when running a plan. If false, then don't run the demand planning engine when running a plan.",
                        "nullable":true
                    },
                    "PlanId":{
                        "type":"integer",
                        "description":"Value that uniquely identifies the plan.",
                        "nullable":false
                    },
                    "PlanSupplyFlag":{
                        "type":"boolean",
                        "description":"Contains one of the following values: true or false. If true, then run supply planning when running a plan. If false, then don't run supply planning.",
                        "nullable":true
                    },
                    "RecalculateSafetyStockFlag":{
                        "type":"boolean",
                        "description":"Contains one of the following values: true or false. If true, then the safety stock is recalculated when running a plan. If false, then the safety stock isn't recalculated. This value is applicable only when the safety stock planning method plan option isn't 1: Don't plan safety stock or 4: User-specified values for all items.",
                        "nullable":true
                    },
                    "SavePlanToDb":{
                        "type":"string",
                        "description":"This attribute isn't currently used.",
                        "nullable":true
                    },
                    "SimulateForecastProfileId":{
                        "type":"integer",
                        "description":"Unique identifier of the forecast profile associated with the simulate demand request.",
                        "nullable":true
                    },
                    "StartDate":{
                        "type":"string",
                        "description":"Date and time to start the scheduled process.",
                        "format":"date-time",
                        "nullable":true
                    },
                    "Status":{
                        "type":"integer",
                        "description":"Status of the plan run. Contains one of the following values. 0: completed, 1: processing, 2: error, or 3: warning. A list of accepted values is defined in the lookup type ORA_MSC_PLAN_STATUS_TYPE.",
                        "format":"int32",
