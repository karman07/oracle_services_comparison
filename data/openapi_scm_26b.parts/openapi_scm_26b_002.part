                        "operationRef":"#/paths/~1tradeOperations~1{TradeOperationId}~1child~1charges~1{TradeOperationChargeId}~1child~1chargeTransferOrderShipLines/get",
                        "parameters":{
                            "TradeOperationId":"$request.path.TradeOperationId",
                            "TradeOperationChargeId":"$request.path.TradeOperationChargeId"
                        },
                        "description":"Transfer order shipment lines which are associated with the charge line for the allocation of landed cost charges."
                    },
                    "cancelChargeLine":{
                        "operationRef":"#/paths/~1tradeOperations~1{TradeOperationId}~1child~1charges~1{TradeOperationChargeId}~1action~1cancelChargeLine/post",
                        "parameters":{
                            "TradeOperationId":"$request.path.TradeOperationId",
                            "TradeOperationChargeId":"$request.path.TradeOperationChargeId"
                        },
                        "description":"Cancels the selected charge line for the trade operation."
                    },
                    "chargeRelatedLines":{
                        "operationRef":"#/paths/~1tradeOperations~1{TradeOperationId}~1child~1charges~1{TradeOperationChargeId}~1child~1chargeRelatedLines/get",
                        "parameters":{
                            "TradeOperationId":"$request.path.TradeOperationId",
                            "TradeOperationChargeId":"$request.path.TradeOperationChargeId"
                        },
                        "description":"The Charge Related Lines resource gets information about the related charge lines for a charge line."
                    },
                    "chargeInvoiceAssociations":{
                        "operationRef":"#/paths/~1tradeOperations~1{TradeOperationId}~1child~1charges~1{TradeOperationChargeId}~1child~1chargeInvoiceAssociations/get",
                        "parameters":{
                            "TradeOperationId":"$request.path.TradeOperationId",
                            "TradeOperationChargeId":"$request.path.TradeOperationChargeId"
                        },
                        "description":"The Charge Invoice Associations resource gets information about the invoice associated with a charge line."
                    },
                    "chargeReferences":{
                        "operationRef":"#/paths/~1tradeOperations~1{TradeOperationId}~1child~1charges~1{TradeOperationChargeId}~1child~1chargeReferences/get",
                        "parameters":{
                            "TradeOperationId":"$request.path.TradeOperationId",
                            "TradeOperationChargeId":"$request.path.TradeOperationChargeId"
                        },
                        "description":"The Charge References resource gets information about the charge references associated with a charge line."
                    },
                    "chargePurchaseOrderSchedules":{
                        "operationRef":"#/paths/~1tradeOperations~1{TradeOperationId}~1child~1charges~1{TradeOperationChargeId}~1child~1chargePurchaseOrderSchedules/get",
                        "parameters":{
