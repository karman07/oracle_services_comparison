                    },
                    "resourceParameters":{
                        "operationRef":"#/paths/~1productionSchedulingOrganizations~1{OrganizationId}~1child~1resourceParameters/get",
                        "parameters":{
                            "OrganizationId":"$request.path.OrganizationId"
                        },
                        "description":"The Resource Parameters resource manages the definition of production scheduling specific resource parameters that aren't defined in Oracle Manufacturing Cloud."
                    },
                    "itemParameters":{
                        "operationRef":"#/paths/~1productionSchedulingOrganizations~1{OrganizationId}~1child~1itemParameters/get",
                        "parameters":{
