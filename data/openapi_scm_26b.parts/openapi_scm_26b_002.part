            "demandAndSupplyPlans-Items-item-post-request":{
                "type":"object",
                "properties":{
                    "ABCClass":{
                        "maxLength":40,
                        "type":"string",
                        "description":"Code assigned to the item for classification purposes. Items are divided into categories called ABC classes, such as A, B, and C, according to a criterion such as revenue generation, turnover, or value.",
                        "nullable":true
                    },
                    "AcceptableEarlyDays":{
                        "type":"integer",
                        "description":"Number of days before which the planning process won't reschedule the sales order. For example, if the due date on the original sales order is June 10, and if the Acceptable Early Days is 3, and if the new due date is less than or equal to June 13 then the planning process won't suggest rescheduling.",
                        "nullable":true
                    },
                    "AnnualCarryingCostPercentage":{
                        "type":"number",
                        "description":"Percent of unit cost that represents the internal cost to stock one unit for one year.",
                        "nullable":true
                    },
                    "AverageInterarrivalTime":{
                        "type":"number",
                        "description":"Average time, expressed in days, between intervals.",
                        "nullable":true
                    },
                    "AverageInterarrivalTimeOvrride":{
                        "type":"number",
                        "description":"Number of days specified by the user to override the average interarrival time, where the average interarrival time is the average time, expressed in days, between intervals.",
                        "nullable":true
                    },
                    "Buyer":{
                        "maxLength":240,
                        "type":"string",
                        "description":"Name of the buyer associated with the item.",
                        "nullable":true
                    },
                    "CalculateATPIndicator":{
                        "type":"integer",
                        "description":"Value that indicates whether to enable available-to-promise functionality in Oracle Fusion Cloud Global Order Promising when planning for this item. Valid values are 1 and 2. If 1, then available-to-promise functionality is enabled. If 2, then available-to-promise functionality isn't enabled.",
                        "nullable":false
                    },
                    "ConsiderInClearToBuild":{
                        "maxLength":1,
                        "type":"string",
                        "description":"Value that indicates whether to include this component item when calculating clear-to-build for an assembly item. Valid values are 1 or 2. If 1, then this component item is included. If 2, then it's not.",
                        "nullable":true
                    },
                    "CreateSupply":{
                        "type":"integer",
                        "description":"Value that indicates whether planning creates planned orders for this item. Valid values are 1 or 2. If 1, then planned orders are created. If 2, then planned orders aren't created.",
                        "nullable":true
                    },
                    "CreateSupplyAfter":{
                        "type":"string",
                        "description":"Date after which supplies can be created. This attribute is editable only when the CreateSupply attribute is set to 1.",
                        "format":"date",
                        "nullable":true
                    },
                    "CriticalComponent":{
                        "type":"integer",
                        "description":"Value that indicates whether the item is a critical component or not. Valid values are 1 or 2. If 1, then the item is a critical component. If 2, then the item isn't a critical component.",
                        "nullable":true
                    },
                    "DaysOfCover":{
                        "type":"number",
                        "description":"Number of days of cover for the item. Days of Cover is multiplied by the average demand to calculate the safety stock level.",
                        "nullable":true
                    },
                    "DaysOfCoverDemandPeriod":{
                        "type":"integer",
                        "description":"Period of time, specified as a number of days, used to determine the average gross demand when using the Days of Cover method to calculate safety stock.",
                        "nullable":true
                    },
                    "DemandTimeFenceCode":{
                        "type":"integer",
                        "description":"Abbreviation that identifies the point in time inside which the planning process ignores forecast demand and considers only sales order demand when calculating gross requirements. A list of accepted values is defined in the lookup type ORA_MSC_TIME_FENCE_TYPES.",
                        "nullable":true
                    },
                    "DemandTimeFenceDays":{
                        "type":"integer",
                        "description":"Time horizon, expressed in number of days, within which forecast demand is ignored.",
                        "nullable":true
                    },
                    "Description":{
                        "maxLength":240,
                        "type":"string",
                        "description":"Description of the item.",
                        "nullable":true
                    },
                    "DiscountPercentage":{
                        "type":"number",
                        "description":"Average discount for the item.",
                        "nullable":true
                    },
                    "EnforcePurchasingLeadTime":{
                        "type":"integer",
                        "description":"Value that indicates whether purchasing lead times are imposed as a hard constraint during constraint-based planning. Valid values are: Yes or No. If Yes, then purchasing lead times are enforced. If No, then purchasing lead times aren't enforced.",
                        "format":"int32",
                        "nullable":true,
                        "x-hints":{
                            "precision":1
                        }
                    },
                    "ExcessHorizon":{
                        "type":"number",
                        "description":"Time horizon, expressed in number of days, after which inventory is considered excess.",
                        "nullable":true
                    },
                    "FixedDaysOfSupply":{
                        "type":"number",
                        "description":"Number of days to use to modify the size and timing of each planned order quantity.",
                        "nullable":true
                    },
                    "FixedLeadTime":{
                        "type":"number",
                        "description":"Number of days required to assemble an item independent of the sales order quantity, such as setup time or tear down time.",
                        "nullable":true
                    },
                    "FixedLotMultiplier":{
                        "type":"number",
                        "description":"Multiplier to use, in units for each day, for each fixed lot quantity or each repetitive rate.",
                        "nullable":true
                    },
                    "FixedOrderQuantity":{
                        "type":"number",
                        "description":"Quantity to use to modify the size of each planned order quantity or each repetitive daily rate.",
                        "nullable":true
                    },
                    "ForecastErrorType":{
                        "maxLength":30,
                        "type":"string",
                        "description":"Value that indicates how the quality of a forecast is measured. A list of accepted values is defined in the lookup type MSC_FORECAST_ERROR_TYPES.",
                        "nullable":true
                    },
                    "IntermittentDemand":{
                        "type":"number",
                        "description":"Value that indicates whether the demand for the item has an irregular frequency or not. Valid values are: 1 or 2. If 1, then demand for the item has an irregular frequency . If 2, then not.",
                        "nullable":true
                    },
                    "IntermittentDemandOverride":{
                        "type":"string",
                        "description":"Value specified by the user to override the Intermittent Demand, where Intermittent Demand indicates whether the demand has an irregular frequency or not. Valid values are: 1 or 2. If 1, then demand for the item has an irregular frequency . If 2, then not.",
                        "nullable":true
                    },
                    "InventoryItemId":{
                        "type":"integer",
                        "description":"Value that uniquely identifies the item.",
                        "format":"int64",
                        "nullable":false,
                        "x-hints":{
                            "precision":18
                        }
                    },
                    "ItemName":{
                        "maxLength":300,
                        "type":"string",
                        "description":"Name of the item.",
                        "nullable":true
                    },
                    "LeadTimeOffsetPeriodBkts":{
                        "type":"number",
                        "description":"Number of months or periods in which the constrained supply plan offsets the lead time, after converting the number of months or periods to days. Month buckets are used if the supply planning calendar is Gregorian. Value can be null or greater than or equal to zero. This attribute doesn't have a default value.",
                        "nullable":true
                    },
                    "LeadTimeOffsetWeekBkts":{
                        "type":"number",
                        "description":"Number of weeks in which the constrained supply plan offsets the lead time, after converting the number of weeks to days. Value can be null or greater than or equal to zero. This attribute doesn't have a default value.",
                        "nullable":true
                    },
                    "LifeCyclePhase":{
                        "maxLength":120,
                        "type":"string",
                        "description":"Name of lifecycle phase of the item.",
                        "nullable":true
                    },
                    "MADOverride":{
                        "type":"number",
                        "description":"Value that's the user override of the mean absolute deviation, where mean absolute deviation is a statistical formula used to measure the quantity deviation between actual and forecasted demand.",
                        "nullable":true
                    },
                    "MAPEOverride":{
                        "type":"number",
                        "description":"Value that's the user override of the mean absolute percentage error, where mean absolute percentage error is a statistical formula used to measure the percentage deviation between actual and forecasted demand.",
                        "nullable":true
                    },
                    "MaximumOrderQuantity":{
                        "type":"number",
                        "description":"Maximum order quantity of the item.",
                        "nullable":true
                    },
                    "MinimumOrderQuantity":{
                        "type":"number",
                        "description":"Minimum order quantity of the item.",
                        "nullable":true
                    },
                    "NewPlanId":{
                        "type":"integer",
                        "description":"Most recent value that uniquely identifies the plan.",
                        "nullable":false,
                        "x-hints":{
                            "PAYLOADHINT":"Show"
                        }
                    },
                    "ObsolescenceDate":{
                        "type":"string",
                        "description":"Date when the item is obsolete.",
                        "format":"date",
                        "nullable":true
                    },
                    "OrderCost":{
                        "type":"number",
                        "description":"Fixed costs that are associated with placing a sales order for the item.",
                        "nullable":true
                    },
                    "OrderModifierToStartQuantity":{
                        "type":"integer",
                        "description":"Value that indicates whether order modifiers are applied to start quantity or not. Valid values are: 1 or 2. If 1, then order modifiers are applied to start quantity. If 2, then not.",
                        "nullable":true
                    },
                    "Organization":{
                        "maxLength":49,
                        "type":"string",
                        "description":"Abbreviation that identifies the organization associated with the item.",
                        "nullable":true
                    },
                    "OrganizationId":{
                        "type":"integer",
                        "description":"Value that uniquely identifies the organization.",
                        "format":"int64",
                        "nullable":false,
                        "x-hints":{
                            "precision":18
                        }
                    },
                    "Planner":{
                        "maxLength":10,
                        "type":"string",
                        "description":"Abbreviation that identifies the planner responsible for the item.",
                        "nullable":true
                    },
                    "PlanningMethodCode":{
                        "type":"integer",
                        "description":"Abbreviation that indicates the type of planning used for the item. A list of accepted values is defined in the lookup type ORA_MSC_PLANNING_CODE.",
                        "nullable":false
                    },
                    "PlanningTimeFenceCode":{
                        "type":"integer",
                        "description":"Abbreviation that identifies the point in time inside which the planning process won't schedule a supply order to be due. A list of accepted values is defined in the lookup type ORA_MSC_TIME_FENCE_TYPES.",
                        "nullable":true
                    },
                    "PlanningTimeFenceDays":{
                        "type":"integer",
                        "description":"Time horizon, in number of days, in which supply orders aren't scheduled to be due.",
                        "nullable":true
                    },
                    "PostprocessingLeadTime":{
                        "type":"number",
                        "description":"Number of days required to make an item available in inventory once the supply is complete.",
                        "nullable":true
                    },
                    "PreprocessingLeadTime":{
                        "type":"number",
                        "description":"Number of days which must be added to purchasing or manufacturing lead time to place an order.",
                        "nullable":true
                    },
                    "ProcessingLeadTime":{
                        "type":"number",
                        "description":"Number of days required to procure or manufacture an item.",
                        "nullable":true
                    },
                    "ReleaseTimeFenceCode":{
                        "type":"integer",
                        "description":"Abbreviation that identifies the point in time inside which planned orders with certain criteria are automatically released as work orders or purchase orders. A list of accepted values is defined in the lookup type ORA_MSC_TIME_FENCE_TYPES.",
                        "nullable":true
                    },
                    "ReleaseTimeFenceDays":{
                        "type":"integer",
                        "description":"Time horizon, in number of days, in which orders are automatically released as work orders or purchase requisitions.",
                        "nullable":true
                    },
                    "Rounding":{
                        "type":"integer",
                        "description":"Value that indicates whether planned order quantity is rounded to a whole number or not. Valid values are: 1 or 2. If 1, then planned order quantity is rounded. If 2, then not.",
                        "nullable":false
                    },
                    "SafetyStockCode":{
                        "type":"integer",
                        "description":"Value that identifies the method that planning uses to calculate safety stock levels for the item. A list of accepted values is defined in the lookup type ORA_MSC_SS_PLANNING_METHD.",
                        "nullable":false
                    },
                    "SafetyStockPlanningMethod":{
                        "maxLength":4000,
                        "type":"string",
                        "description":"Meaning associated with the SafetyStockCode attribute.",
                        "nullable":true
                    },
                    "SafetyStockQuantity":{
                        "type":"number",
                        "description":"Desired level of safety stock of an item.",
                        "nullable":true
                    },
                    "SafetyStockQuantityOverride":{
                        "type":"number",
                        "description":"Numeric value provided by the user to override the standard safety stock quantity of an item.",
                        "nullable":true,
                        "x-hints":{
                            "precision":20
                        }
                    },
                    "SellingPrice":{
                        "type":"number",
                        "description":"Selling price of the item.",
                        "nullable":true
                    },
                    "ServiceLevelPercent":{
                        "type":"number",
                        "description":"Desired level of customer service, expressed as a percentage, in satisfying product demand. This represents the probability that an order can be filled from available inventory.",
                        "nullable":true
                    },
                    "ShrinkageRate":{
                        "type":"number",
                        "description":"Average amount of material you expect to lose when manufacturing or storing the item.",
                        "nullable":true
                    },
                    "StandardCost":{
                        "type":"number",
                        "description":"Standard cost of an item.",
                        "nullable":true
                    },
                    "VariableLeadTime":{
                        "type":"number",
                        "description":"Time to produce one unit of an assembly.",
                        "nullable":true
                    }
                }
            },
