                                },
                                "format":"int64",
                                "description":"Value that creates a relationship between the serial number and the shipment line. If the line has shipped, then this attribute identifies the shipment line. If the line hasn't shipped, then this attribute identifies the transaction for a row in a temporary transaction table that references the serial number.",
                                "type":"integer"
                            }
