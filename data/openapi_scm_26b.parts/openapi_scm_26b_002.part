            "oracle_apps_scm_advancedPlanning_common_planRuns_restModel_view_MscOrderVDemandVO_Rest__Shape-item":{
                "type":"object",
                "properties":{
                    "Action":{
                        "maxLength":80,
                        "type":"string",
                        "description":"Value that indicates the type of recommended change made by the planning engine to the supply or demand. Valid values include None, Cancel, Reschedule in, Reschedule out, Release, Release reservation, and Reschedule and release reservation. A list of accepted values is defined in the lookup type ORA_MSC_ACTIONS.",
                        "nullable":true,
                        "readOnly":true
                    },
                    "ActionCode":{
                        "type":"integer",
                        "description":"Code that indicates the type of recommended change made by the planning engine to the supply or demand. Valid values are 1: Cancel, 2: Reschedule in, 3: Reschedule out, 4: Release, 5: Release reservation, 6: None, and 7: Reschedule and release reservation. A list of accepted values is defined in the lookup ORA_MSC_ACTIONS.",
                        "nullable":true,
                        "readOnly":true
                    },
                    "AlternateUOM":{
                        "maxLength":3,
                        "type":"string",
                        "description":"Alternate unit of measure code of the item in the order.",
                        "nullable":true
                    },
                    "AlternateUOMName":{
                        "title":"Alternate UOM",
                        "maxLength":4000,
                        "type":"string",
                        "description":"Name associated with the alternate unit of measure of the item in the order.",
                        "nullable":true,
                        "readOnly":true
                    },
                    "AssetNumber":{
                        "title":"Asset",
                        "maxLength":80,
                        "type":"string",
                        "description":"Number that identifies the asset associated with a maintenance work order.",
                        "nullable":true,
                        "readOnly":true
                    },
                    "AttributeRowId":{
                        "type":"integer",
                        "description":"Unique identifier for the supply or demand's associated free-text display attributes.",
                        "format":"int64",
                        "nullable":true,
                        "x-hints":{
                            "precision":18
                        }
                    },
                    "BOMItemType":{
                        "type":"integer",
                        "description":"Name of the item type. Valid values include 1: Model, 2: Option Class, 3: Planning, 4: Standard, and 5: Product Family. A list of accepted values is defined in the lookup type ORA_MSC_BOM_ITEM_TYPE.",
                        "nullable":true
                    },
                    "BillSequenceId":{
                        "type":"integer",
                        "description":"Value that uniquely identifies the sequence in which a component is used within an operation.",
                        "format":"int64",
                        "nullable":true,
                        "x-hints":{
                            "precision":18
                        }
                    },
                    "BucketType":{
                        "title":"Bucket Type",
                        "maxLength":7,
                        "type":"string",
                        "description":"Time bucket used for forecast demands. Valid values include Day, Month, Period, or Week. A list of accepted values is defined in the lookup types ORA_MSC_TIME_LEVELS_GREGORIAN and ORA_MSC_TIME_LEVELS_MFG.",
                        "nullable":true,
                        "readOnly":true
                    },
                    "Buyer":{
                        "title":"Buyer",
                        "type":"string",
                        "description":"Name of the buyer associated with the item.",
                        "nullable":true,
                        "readOnly":true
                    },
                    "CatalogId":{
                        "type":"integer",
                        "description":"Value that uniquely identifies the catalog.",
                        "nullable":true,
