                "links":{
                    "StockLocationsRestVO1":{
                        "operationRef":"#/paths/~1stockingLocations/get",
                        "description":"The following properties are defined on the LOV link relation:<br><ul><li>Source Attribute: StockLocationId; Target Attribute: StockLocationId</li><li>Display Attribute: SubinventoryName, ConditionMeaning</li></ul>",
                        "x-lov":{
                            "definedOn":"$request.body#/StockLocationId",
                            "displayValues":[
                                "SubinventoryName"
                            ],
                            "itemsPath":"items",
                            "valueField":"StockLocationId",
                            "displayFields":[
                                "SubinventoryName",
                                "ConditionMeaning"
                            ]
                        }
                    },
                    "PersonsLOVVO1":{
                        "operationRef":"#/paths/~1serviceLogisticsPersonsLOV/get",
                        "description":"The following properties are defined on the LOV link relation:<br><ul><li>Source Attribute: PartyId; Target Attribute: PartyId</li><li>Display Attribute: PartyName, PartyNumber, TechEmail, TechPhone</li></ul>",
                        "x-lov":{
                            "definedOn":"$request.body#/PartyId",
                            "displayValues":[
                                "PartyName"
                            ],
                            "itemsPath":"items",
                            "valueField":"PartyId",
                            "displayFields":[
                                "PartyName",
                                "PartyNumber",
                                "TechEmail",
                                "TechPhone"
                            ]
                        }
                    },
                    "StockLocationsOrgLOVVO1":{
                        "operationRef":"#/paths/~1stockingLocationOrganizationsLOV/get",
                        "description":"The following properties are defined on the LOV link relation:<br><ul><li>Source Attribute: OrganizationId; Target Attribute: OrganizationId</li><li>Display Attribute: OrganizationName, OrganizationCode</li></ul>",
                        "x-lov":{
                            "definedOn":"$request.body#/OrganizationId",
                            "displayValues":[
                                "OrganizationName"
                            ],
                            "itemsPath":"items",
                            "valueField":"OrganizationId",
                            "displayFields":[
                                "OrganizationName",
                                "OrganizationCode"
                            ]
                        }
                    }
                }
            },
