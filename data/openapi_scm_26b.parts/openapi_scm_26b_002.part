            "shipmentLineChangeRequests-collection-response":{
                "description":"The following table describes the default response for this task.",
                "headers":{
                    "Metadata-Context":{
                        "$ref":"#/components/headers/Metadata-Context"
                    },
                    "REST-Framework-Version":{
                        "$ref":"#/components/headers/REST-Framework-Version"
                    }
                },
                "content":{
                    "application/json":{
                        "schema":{
                            "$ref":"#/components/schemas/shipmentLineChangeRequests"
                        }
                    }
                },
                "links":{
                    "submitForApproval":{
                        "operationRef":"#/paths/~1shipmentLineChangeRequests~1action~1submitForApproval/post",
                        "description":"Submits quick-ship eligible shipment lines for the E-Record and E-Signature approval processes."
                    },
                    "autoCreate":{
                        "operationRef":"#/paths/~1shipmentLineChangeRequests~1action~1autoCreate/post",
                        "description":"Creates shipments for the shipment lines or packing units."
                    },
                    "split":{
                        "operationRef":"#/paths/~1shipmentLineChangeRequests~1action~1split/post",
                        "description":"Splits a shipment line. When splitting a shipment line, a new line is created for the specified quantity by copying the existing line, and the quantity in the original line is reduced."
                    },
                    "autoPack":{
                        "operationRef":"#/paths/~1shipmentLineChangeRequests~1action~1autoPack/post",
                        "description":"Packs the shipment lines and packing unit based on the default packing configuration."
                    },
                    "splitToMultipleLines":{
                        "operationRef":"#/paths/~1shipmentLineChangeRequests~1action~1splitToMultipleLines/post",
                        "description":"Splits a shipment line into multiple lines. When a shipment line is split, a new line is created for the specified quantity by copying the existing line and reducing the quantity in the original line."
                    },
                    "generateShipmentRequest":{
                        "operationRef":"#/paths/~1shipmentLineChangeRequests~1action~1generateShipmentRequest/post",
                        "description":"Selects and sends shipment lines to external applications such as a warehouse management system and also indicates the lines as interfaced. The shipment lines are selected using input parameters, assigned to a picking batch, and their integration status is set to interfaced. The input parameters can be an existing picking batch name, an organization code, or a pick wave release rule."
                    },
                    "pickRelease":{
                        "operationRef":"#/paths/~1shipmentLineChangeRequests~1action~1pickRelease/post",
                        "description":"Pick releases the shipment lines or packing units by submitting Release Pick Wave scheduled process."
                    },
                    "resetIntegrationStatus":{
                        "operationRef":"#/paths/~1shipmentLineChangeRequests~1action~1resetIntegrationStatus/post",
                        "description":"Reset the integration status of the shipment lines that are interfaced with the external execution system."
                    },
                    "unpack":{
                        "operationRef":"#/paths/~1shipmentLineChangeRequests~1action~1unpack/post",
                        "description":"Unpacks shipment lines or packing units from their parent unit."
                    },
                    "backorderLine":{
                        "operationRef":"#/paths/~1shipmentLineChangeRequests~1action~1backorderLine/post",
                        "description":"Backorders a shipment line according to the shipment line number. The input parameters can include the quantity to be backordered."
                    },
                    "resetWeightVolume":{
                        "operationRef":"#/paths/~1shipmentLineChangeRequests~1action~1resetWeightVolume/post",
                        "description":"Resets the weight and volume to default value on the shipment lines and packing units."
                    },
                    "backorderAll":{
                        "operationRef":"#/paths/~1shipmentLineChangeRequests~1action~1backorderAll/post",
                        "description":"Backorders the selected shipment lines that are in staged status or interfaced with the WMS."
                    },
                    "cycleCountLineFromLPN":{
                        "operationRef":"#/paths/~1shipmentLineChangeRequests~1action~1cycleCountLineFromLPN/post",
                        "description":"Backorders the shipment lines, unassigns the lines and quantities from the LPN, and creates cycle count reservations for the backordered content."
                    },
                    "cycleCountAll":{
                        "operationRef":"#/paths/~1shipmentLineChangeRequests~1action~1cycleCountAll/post",
                        "description":"Backorders the shipment lines associated with the LPN and creates cycle count reservations for the LPN content."
                    },
                    "backorderLineFromLPN":{
                        "operationRef":"#/paths/~1shipmentLineChangeRequests~1action~1backorderLineFromLPN/post",
                        "description":"Backorders a shipment line that's packed in an LPN and unassigns the line from the LPN."
                    },
                    "pack":{
                        "operationRef":"#/paths/~1shipmentLineChangeRequests~1action~1pack/post",
                        "description":"Packs the shipment lines or packing units into a packing unit."
                    },
                    "changeTransportationPlan":{
                        "operationRef":"#/paths/~1shipmentLineChangeRequests~1action~1changeTransportationPlan/post",
                        "description":"Changes the transportation plan for the specified shipment lines."
                    },
                    "unassign":{
                        "operationRef":"#/paths/~1shipmentLineChangeRequests~1action~1unassign/post",
                        "description":"Unassigns the shipment lines or packing units from a shipment. Optionally, you can reassign the shipment lines or packing numbers from a shipment to a different shipment in a single step."
                    },
                    "confirm":{
                        "operationRef":"#/paths/~1shipmentLineChangeRequests~1action~1confirm/post",
                        "description":"Ship confirms the quick-ship eligible shipment lines for an organization that's enabled for quick ship."
                    },
                    "rePackLPN":{
                        "operationRef":"#/paths/~1shipmentLineChangeRequests~1action~1rePackLPN/post",
                        "description":"Transfers the shipment line from one LPN to another. This is used only for LPN-enabled organizations."
                    },
                    "stage":{
                        "operationRef":"#/paths/~1shipmentLineChangeRequests~1action~1stage/post",
                        "description":"Stages the quick-ship eligible shipment lines for an organization that's enabled for quick ship."
                    },
                    "loadAssignments":{
                        "operationRef":"#/paths/~1shipmentLineChangeRequests~1action~1loadAssignments/post",
                        "description":"Assigns shipment lines and packing units to a load. Supported actions include assigning and unassigning them from a load, as well as automatically creating a load for shipment lines and packing units."
                    },
                    "cycleCount":{
                        "operationRef":"#/paths/~1shipmentLineChangeRequests~1action~1cycleCount/post",
                        "description":"Transfers the shipment line to cycle counting."
                    },
                    "checkTradeCompliance":{
                        "operationRef":"#/paths/~1shipmentLineChangeRequests~1action~1checkTradeCompliance/post",
                        "description":"Sends the shipment lines or packing units to the trade management system for trade compliance screening."
                    },
                    "assign":{
                        "operationRef":"#/paths/~1shipmentLineChangeRequests~1action~1assign/post",
                        "description":"Adds the shipment lines or packing units in a shipment. Optionally, a shipment line or packing unit assigned to another shipment can be added by unassigning it from the current shipment and adding it to the specified shipment."
                    },
                    "resetQuickshipStatus":{
                        "operationRef":"#/paths/~1shipmentLineChangeRequests~1action~1resetQuickshipStatus/post",
                        "description":"Clears the quick ship status for the selected shipment lines."
                    }
                }
            },
