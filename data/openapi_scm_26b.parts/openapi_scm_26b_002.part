                        "parameters":{
                            "OrganizationId":"$request.path.OrganizationId"
                        },
                        "description":"The definition of a production scheduling-specific parameter."
                    },
                    "resourceGroups":{
                        "operationRef":"#/paths/~1productionSchedulingOrganizations~1{OrganizationId}~1child~1resourceGroups/get",
                        "parameters":{
                            "OrganizationId":"$request.path.OrganizationId"
                        },
                        "description":"The Resource Groups resource manages the user defined groupings of resources that are used in simplifying changeover rule definition and user interface filtering."
                    },
                    "refreshOrganizationData":{
                        "operationRef":"#/paths/~1productionSchedulingOrganizations~1{OrganizationId}~1action~1refreshOrganizationData/post",
