                        "operationRef":"#/paths/~1productionSchedulingPlans~1{PlanId}~1action~1refreshPlanData/post",
                        "parameters":{
                            "PlanId":"$request.path.PlanId"
                        },
                        "description":"Refreshes and solves a plan in either constrained or unconstrained mode."
                    },
                    "calendarEvents":{
                        "operationRef":"#/paths/~1productionSchedulingPlans~1{PlanId}~1child~1calendarEvents/get",
                        "parameters":{
                            "PlanId":"$request.path.PlanId"
                        },
                        "description":"The Calendar Events resource manages the specific events on a calendar that indicates what time a resource is available."
                    },
                    "repairPlan":{
                        "operationRef":"#/paths/~1productionSchedulingPlans~1{PlanId}~1action~1repairPlan/post",
                        "parameters":{
                            "PlanId":"$request.path.PlanId"
                        },
                        "description":"Requests to manually schedule a work order operation resource for a given schedule."
                    },
                    "lateWorkOrderMeasures":{
                        "operationRef":"#/paths/~1productionSchedulingPlans~1{PlanId}~1child~1lateWorkOrderMeasures/get",
                        "parameters":{
                            "PlanId":"$request.path.PlanId"
                        },
                        "description":"The KPI for Late Work Orders resource manages the key performance indicator for late work orders of the production schedule used for reporting."
                    },
                    "resourceOperationSequences":{
                        "operationRef":"#/paths/~1productionSchedulingPlans~1{PlanId}~1child~1resourceOperationSequences/get",
                        "parameters":{
                            "PlanId":"$request.path.PlanId"
                        },
                        "description":"The Resource Operation Sequences resource manages the sequence of operations that occur on a production resource."
                    },
                    "updateWorkOrderOperations":{
                        "operationRef":"#/paths/~1productionSchedulingPlans~1{PlanId}~1action~1updateWorkOrderOperations/post",
                        "parameters":{
                            "PlanId":"$request.path.PlanId"
                        },
                        "description":"Request to update work order operation properties to facilitate mass editing operations."
                    },
                    "lateDemandMeasures":{
                        "operationRef":"#/paths/~1productionSchedulingPlans~1{PlanId}~1child~1lateDemandMeasures/get",
                        "parameters":{
                            "PlanId":"$request.path.PlanId"
                        },
                        "description":"The KPI for Late Demands resource manages the key performance indicator for late demands of the production schedule used for reporting."
                    },
                    "releasePlan":{
                        "operationRef":"#/paths/~1productionSchedulingPlans~1{PlanId}~1action~1releasePlan/post",
                        "parameters":{
                            "PlanId":"$request.path.PlanId"
                        },
                        "description":"Requests to release a plan to the source application according to the release horizon."
                    },
                    "resources":{
                        "operationRef":"#/paths/~1productionSchedulingPlans~1{PlanId}~1child~1resources/get",
                        "parameters":{
                            "PlanId":"$request.path.PlanId"
                        },
                        "description":"The Resources resource manages production resources that are part of the production schedule."
                    },
                    "updateWorkOrders":{
                        "operationRef":"#/paths/~1productionSchedulingPlans~1{PlanId}~1action~1updateWorkOrders/post",
                        "parameters":{
                            "PlanId":"$request.path.PlanId"
                        },
                        "description":"Request to update work order properties to facilitate mass editing work orders."
                    },
                    "productionLines":{
                        "operationRef":"#/paths/~1productionSchedulingPlans~1{PlanId}~1child~1productionLines/get",
                        "parameters":{
                            "PlanId":"$request.path.PlanId"
                        },
                        "description":"Management of the details of the rate-based lines in the organization."
                    },
                    "reservations":{
                        "operationRef":"#/paths/~1productionSchedulingPlans~1{PlanId}~1child~1reservations/get",
                        "parameters":{
                            "PlanId":"$request.path.PlanId"
                        },
                        "description":"The Reservations resource manages the reservations in a schedule."
                    },
                    "calendars":{
                        "operationRef":"#/paths/~1productionSchedulingPlans~1{PlanId}~1child~1calendars/get",
                        "parameters":{
                            "PlanId":"$request.path.PlanId"
                        },
                        "description":"The Calendars resource manages the calendars that are part of the schedule to establish availability."
                    },
                    "attributes":{
                        "operationRef":"#/paths/~1productionSchedulingPlans~1{PlanId}~1child~1attributes/get",
                        "parameters":{
                            "PlanId":"$request.path.PlanId"
                        },
                        "description":"The Attributes resource manages the attributes that are a part of the plan that are used for scheduling."
                    },
                    "resourceUtilizationMeasures":{
                        "operationRef":"#/paths/~1productionSchedulingPlans~1{PlanId}~1child~1resourceUtilizationMeasures/get",
                        "parameters":{
                            "PlanId":"$request.path.PlanId"
                        },
                        "description":"The KPI for Resource Utilization resource manages the summary of the overall utilization of the production resources that are included in the schedule and used for reporting."
                    },
                    "applyCalendarPattern":{
                        "operationRef":"#/paths/~1productionSchedulingPlans~1{PlanId}~1action~1applyCalendarPattern/post",
                        "parameters":{
                            "PlanId":"$request.path.PlanId"
                        },
                        "description":"Request changing recurring calendar events to run scenarios with changing downtime or availability to assess the impact to the schedule."
                    }
                }
